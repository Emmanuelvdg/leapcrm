# Production .env for the VPS — copy to ./.env next to docker-compose.yml
# at the repo root. Never commit the real file (already gitignored via
# **/**/.env, but this one lives at the root so double-check `git status`
# doesn't pick it up).

TAG=latest

PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=replace_me_with_a_strong_password_without_special_characters
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
REDIS_URL=redis://redis:6379

# This is the base domain — every workspace gets its own subdomain under it
# (e.g. acme.leapcrm.tech). www.theleapcrm.com (the marketing site) is
# separate and untouched by this deployment.
# Point both leapcrm.tech and *.leapcrm.tech (A records) at this VPS's IP.
SERVER_URL=https://leapcrm.tech
FRONTEND_URL=https://leapcrm.tech

# Use openssl rand -base64 32 for each. Different from dev's values.
# Back these up outside the VPS — losing ENCRYPTION_KEY permanently strands
# every encrypted secret already stored in the database (workspace AI
# provider API keys, connected-account tokens).
ENCRYPTION_KEY=replace_me_with_a_random_string
# FALLBACK_ENCRYPTION_KEY= # set to the previous ENCRYPTION_KEY only during a rotation
APP_SECRET=replace_me_with_a_random_string

STORAGE_TYPE=local

# EMAIL_DRIVER defaults to LOGGER (emails are logged, not sent) if left unset —
# invites/verification/password-reset will silently no-op without this.
EMAIL_DRIVER=SMTP
EMAIL_FROM_ADDRESS=contact@leapcrm.tech
EMAIL_FROM_NAME=LeapCRM
EMAIL_SMTP_HOST=smtp.yourprovider.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=replace_me
EMAIL_SMTP_PASSWORD=replace_me

# Live-mode Stripe keys — dev uses sk_test_..., production needs the real ones.
# Create a live-mode webhook endpoint in the Stripe dashboard pointed at
# https://leapcrm.tech against the subscription-billing webhook route,
# and set its signing secret below.
IS_SUBSCRIPTION_BILLING_ENABLED=true
SUBSCRIPTION_STRIPE_API_KEY=sk_live_replace_me
SUBSCRIPTION_STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
SUBSCRIPTION_STRIPE_WEBHOOK_SECRET=whsec_replace_me

# These three already default correctly inside docker-compose.yml itself
# (true / false / 0) even if left unset here — listed for visibility only.
# IS_MULTIWORKSPACE_ENABLED=true
# IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=false
# SUBSCRIPTION_TRIAL_DAYS=0
# Leave SUBSCRIPTION_GRANDFATHER_BEFORE unset — its absence means no
# workspace is exempted from the paywall.
