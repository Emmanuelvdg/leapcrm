# On-demand TLS: a normal cert is issued via HTTP-01 the first time each
# hostname is visited (every workspace gets its own subdomain), instead of a
# wildcard cert via DNS-01 — leapcrm.tech's DNS is on Hostinger, which has no
# confirmed Caddy DNS-01 plugin. The `ask` endpoint only allows the base
# domain or a hostname that resolves to a real workspace, so it can't be
# abused to burn the shared Let's Encrypt rate limit.
{
	on_demand_tls {
		ask http://server:3000/internal/tls-cert-ask
	}
}

leapcrm.tech, *.leapcrm.tech {
	tls {
		on_demand
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Report-only for now: index.html has un-nonced inline <script>/<style>
		# tags (env config injection, iOS zoom fix), so an enforcing policy
		# without 'unsafe-inline' would break the app on the first request.
		# Check the browser console for violations, then switch this to
		# Content-Security-Policy once it's confirmed clean.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		# twenty-server runs on Express, which sets this by default.
		-X-Powered-By
	}

	# twenty-server also sends Cache-Control: public, max-age=0 on these
	# files - reverse_proxy's own header_down runs after the upstream
	# response is received, so it replaces that value instead of the plain
	# header directive's Set() landing before reverse_proxy copies the
	# upstream header on top, which produced two stacked Cache-Control
	# values (browsers then honour the more conservative one).
	handle /assets/* {
		reverse_proxy server:3000 {
			header_down -Cache-Control
			header_down Cache-Control "public, max-age=31536000, immutable"
		}
	}

	handle {
		reverse_proxy server:3000
	}
}
