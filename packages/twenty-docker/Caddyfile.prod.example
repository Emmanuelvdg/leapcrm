# Copy this to ./Caddyfile on the VPS (same directory as docker-compose.yml).
#
# Every workspace gets its own subdomain (e.g. acme.leapcrm.tech) — see
# IS_MULTIWORKSPACE_ENABLED in twenty-server. Rather than a wildcard cert
# (which needs a DNS-01 challenge and a provider-specific plugin), this uses
# Caddy's on-demand TLS: a normal per-hostname cert is issued via HTTP-01 the
# first time each subdomain is actually visited. The DNS wildcard record
# (*.leapcrm.tech, already pointed at this VPS) makes every subdomain
# resolve here; the `ask` endpoint below stops anyone from burning the
# Let's Encrypt rate limit by requesting certs for made-up subdomains — it
# only allows the base domain or a hostname that resolves to a real
# workspace (see TlsCertAskController in twenty-server).

{
	on_demand_tls {
		ask http://server:3000/internal/tls-cert-ask
	}
}

leapcrm.tech, *.leapcrm.tech {
	tls {
		on_demand
	}
	reverse_proxy server:3000
}
