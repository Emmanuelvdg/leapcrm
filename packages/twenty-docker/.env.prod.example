# Production .env for the Hostinger VPS — copy to ./.env next to
# docker-compose.yml on the server. Never commit the real file.
# Used with: docker compose -f docker-compose.yml -f docker-compose.prod.yml ...

TAG=latest

PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=replace_me_with_a_strong_password_without_special_characters
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
REDIS_URL=redis://redis:6379

# This is the base domain — every workspace gets its own subdomain under it
# (e.g. acme.app.theleapcrm.com), so this should NOT be your landing page's
# root domain. Point a wildcard DNS record (*.app.theleapcrm.com) here too.
SERVER_URL=https://app.theleapcrm.com
FRONTEND_URL=https://app.theleapcrm.com

# KEY:SECRET from https://developer.godaddy.com/keys — used by Caddy's
# DNS-01 challenge to issue the wildcard TLS cert.
GODADDY_API_TOKEN=replace_me_key:replace_me_secret

# Use openssl rand -base64 32 for each. Different from dev's values.
# Back these up outside the VPS — losing ENCRYPTION_KEY permanently strands
# every encrypted secret already stored in the database (workspace AI
# provider API keys, connected-account tokens).
ENCRYPTION_KEY=replace_me_with_a_random_string
# FALLBACK_ENCRYPTION_KEY= # set to the previous ENCRYPTION_KEY only during a rotation
APP_SECRET=replace_me_with_a_random_string

STORAGE_TYPE=local

# EMAIL_DRIVER defaults to LOGGER (emails are logged, not sent) if left unset —
# invites/verification/password-reset will silently no-op without this.
EMAIL_DRIVER=SMTP
EMAIL_FROM_ADDRESS=contact@yourdomain.com
EMAIL_FROM_NAME=LeapCRM
EMAIL_SMTP_HOST=smtp.yourprovider.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=replace_me
EMAIL_SMTP_PASSWORD=replace_me

# Live-mode Stripe keys — dev uses sk_test_..., production needs the real ones.
# Create a live-mode webhook endpoint in the Stripe dashboard pointed at
# https://yourdomain.com against the subscription-billing webhook route,
# and set its signing secret below.
IS_SUBSCRIPTION_BILLING_ENABLED=true
SUBSCRIPTION_STRIPE_API_KEY=sk_live_replace_me
SUBSCRIPTION_STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
SUBSCRIPTION_STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Defaults to 30 (a real free trial) if unset — would silently give every
# signup 30 free days before Stripe ever attempts the $1 charge, defeating
# the whole point of the intro-price model. Must be 0 in production.
SUBSCRIPTION_TRIAL_DAYS=0
# Dev-only: exempts every workspace created before a given date from the
# paywall. Leave unset in production — an unset value means nothing is
# grandfathered, so the paywall applies to every workspace from day one.
# SUBSCRIPTION_GRANDFATHER_BEFORE=

# Defaults to false if unset, which would collapse every workspace into a
# single shared instance — required true for the per-tenant subdomain
# routing (<workspace>.app.theleapcrm.com) this whole product depends on.
IS_MULTIWORKSPACE_ENABLED=true
# Defaults to TRUE if unset, which blocks anyone but a server admin from
# creating a workspace — must be false or the public signup/checkout flow
# is dead on arrival.
IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=false
